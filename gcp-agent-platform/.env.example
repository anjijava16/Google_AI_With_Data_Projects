# Copy to .env and fill in. `terraform output env_exports` prints most of these.
GOOGLE_CLOUD_PROJECT=project-52e8c95d-822f-4563-a7e
GOOGLE_CLOUD_LOCATION=us-central1

# Routes the google-genai SDK to Agent Platform instead of the public Gemini API.
# Getting this wrong is the #1 cause of "why is it asking for an API key".
GOOGLE_GENAI_USE_VERTEXAI=TRUE

ORCHESTRATOR_MODEL=gemini-3.5-flash
REASONING_MODEL=gemini-2.5-pro
EMBEDDING_MODEL=text-embedding-005

RAW_BUCKET=iwinner-gcpadk-data-ai-dev-2e16c6c6
STAGING_BUCKET=gs://iwinner-gcpadk-data-ai-dev-2e16c6c6

# Set after running dia.ingestion.build_corpus
RAG_CORPUS=projects/project-52e8c95d-822f-4563-a7e/locations/us-central1/ragCorpora/1234567890

BQ_DATASET=dia_analytics
BQ_MAX_BYTES_BILLED=2147483648

HITL_TOPIC=dia-approvals
HITL_THRESHOLD=0.75

OTEL_SAMPLE_RATIO=0.1
USE_MANAGED_SESSIONS=false
